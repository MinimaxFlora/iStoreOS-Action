# Seed configuration for the iStoreOS 25.12 x86_64 EFI build.
#
# This is the non-package part of the seed. Package selection lives in
# config/x86_64_efi.packages; scripts/build_istoreos.py concatenates both
# into the final .config and lets 'make defconfig' resolve defaults and
# dependencies. Keeping the two concerns in separate static files makes the
# large official package list easy to regenerate without touching the
# target/image settings.

#
# Target platform: x86 / 64 (generic profile)
#
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"

#
# Root filesystem and image layout
#
# squashfs root with an overlay, matching the official
# istoreos-...-x86-64-squashfs-combined-efi.img.gz layout.
#
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=104

#
# Boot images: EFI only (GRUB EFI), no legacy BIOS combined image.
#
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
CONFIG_GRUB_TITLE="iStoreOS"
